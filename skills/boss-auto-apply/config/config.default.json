{
  "apply": {
    "hard_limit": 150,
    "quota_prompt_limit": 120,
    "min_apply_interval": 8,
    "delay_before_click": [3, 10],
    "delay_after_click": [1, 3],
    "click_jitter": 0.2
  },
  "search": {
    "min_search_interval": 10,
    "request_throttle_max": 30,
    "api_min_interval": 2.0,
    "delay_before_api": [2, 6],
    "page_transition_delay": [3, 8]
  },
  "view": {
    "min_view_interval": 5
  },
  "backoff": {
    "base_seconds": 5,
    "max_seconds": 60,
    "max_retries": 3
  },
  "login": {
    "timeout_seconds": 300,
    "poll_interval": 5
  },
  "risk": {
    "keywords": ["环境存在异常", "安全验证", "操作过于频繁", "code 37", "您的请求过于频繁"]
  }
}
